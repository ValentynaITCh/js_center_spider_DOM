"use strict";
// write code here
window.addEventListener("load", function() {
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    var wallCords = wall.getBoundingClientRect();
    var spiderCords = spider.getBoundingClientRect();
    var newTop = (wallCords.height - spiderCords.height) / 2;
    spider.style.top = newTop + "px";
    var left = (wallCords.width - spiderCords.width) / 2;
    spider.style.left = left + "px";
});

